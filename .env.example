# Copy to .env and fill in. Never commit .env.

# Tailscale: create a reusable auth key at
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-REPLACE-ME
# Machine name on your tailnet. Nextcloud will live at https://<TS_HOSTNAME>.<TS_TAILNET>
TS_HOSTNAME=pi-cloud
# Your tailnet's DNS name, shown under DNS in the Tailscale admin console.
TS_TAILNET=your-tailnet.ts.net

# Mount point of the USB SSD (see prepare-storage.sh). Data, database and
# Nextcloud's own files all live here, not on the SD card.
STORAGE_ROOT=/mnt/ssd/pi-cloud

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE-ME
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=REPLACE-ME
